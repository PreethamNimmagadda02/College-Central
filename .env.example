# EVERY VITE_ VARIABLE IS PUBLIC. Vite copies these values into the JavaScript
# that every visitor downloads. Never put a secret (Gemini, OpenAI, service
# account, ...) in a VITE_ variable. `npm run build` fails if it finds one.

# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini AI (Firebase AI Logic)
# There is no Gemini key in this file: Firebase holds it server-side.
# Setup, once per Firebase project:
# 1. Firebase Console > AI Services > AI Logic > Get started > Gemini Developer API
# 2. Firebase Console > Security > App Check > register the web app with
#    reCAPTCHA Enterprise, then put the site key below (a site key is public)
# 3. For localhost: run the app, copy the "AppCheck debug token" printed in the
#    browser console, and add it under App Check > Apps > Manage debug tokens
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_enterprise_site_key

# ==============================================================================
# SHARED SERVICES (Common across all tenants)
# ==============================================================================

# EmailJS Configuration (for Support Form)
# These credentials are shared across all college instances
# Get these values from your EmailJS Dashboard: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ==============================================================================
# TENANT-SPECIFIC (Change per college deployment)
# ==============================================================================

# College Domain Configuration
# These define which email domains are allowed to access this instance
VITE_ALLOWED_EMAIL_DOMAIN=@iitism.ac.in
VITE_HOSTED_DOMAIN=iitism.ac.in
