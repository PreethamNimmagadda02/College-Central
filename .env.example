# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini AI Configuration
# IMPORTANT: Enable API restrictions in Google Cloud Console:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click on your API key > Edit
# 3. Under "Application restrictions", select "HTTP referrers (web sites)"
# 4. Add these referrers:
#    - https://collegecentral.live/*
#    - http://localhost:3000/*
# 5. Under "API restrictions", select "Restrict key" and enable:
#    - Generative Language API
VITE_GEMINI_API_KEY=your_gemini_api_key_here
