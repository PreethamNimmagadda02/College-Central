#!/bin/sh
# Blocks commits that add credentials. Enabled by `npm install` ("prepare" in package.json).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit was NOT scanned for secrets." >&2
  echo "pre-commit: install it with: brew install gitleaks" >&2
  exit 0
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
