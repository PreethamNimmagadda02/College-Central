# ==============================================================================
# COLLEGE CENTRAL - TENANT CONFIGURATION
# ==============================================================================
# This file contains ONLY tenant-specific settings.
# Shared services (EmailJS) are injected from common secrets during deployment.
# ==============================================================================

# Firebase Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# College Domain Configuration
# VITE_ALLOWED_EMAIL_DOMAIN: Email suffix for login validation (e.g., @stanford.edu)
# VITE_HOSTED_DOMAIN: Google Workspace domain for OAuth (e.g., stanford.edu)
VITE_ALLOWED_EMAIL_DOMAIN=@example.edu
VITE_HOSTED_DOMAIN=example.edu

# Gemini API (Optional - can be shared or per-tenant)
VITE_GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# NOTE: EmailJS is a SHARED service - do not include here
# It will be injected from common GitHub secrets during deployment
# ==============================================================================
